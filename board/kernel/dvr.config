# 叠加在 SDK 的 RV1126B 内核 defconfig 之上
# 需要的功能尽量编进内核（=y），减少启动时加载模块的时间

# 只读根与存储
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_EXT4_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_MMC_BLOCK=y

# 4G 模块 EC25（USB 串口 + QMI 网卡）
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_NET_QMI_WWAN=y

# 看门狗、掉电检测 GPIO、RTC
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_GPIO_CDEV=y
CONFIG_RTC_DRV_PCF8563=y

# 不需要的：显示、GPU、蓝牙、触摸、声音（录音功能确定后再打开）
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_BT is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_SOUND is not set

# 发布版减少启动时的串口打印（cmdline 里配合 quiet）
CONFIG_PRINTK_TIME=y
