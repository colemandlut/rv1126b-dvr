# 叠加在 SDK 的 RV1126B 默认 defconfig 之上（scripts/build.sh 用 merge_config.sh 合并）
# 标 [待核对] 的选项名要等 SDK 到手后对照 Rockchip 的 Buildroot 包名确认

BR2_TARGET_GENERIC_HOSTNAME="dvr"
BR2_TARGET_GENERIC_ISSUE="RV1126B DVR"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Asia/Tokyo"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DVR_PATH)/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DVR_PATH)/post-build.sh"

# 只读根文件系统：squashfs + lz4（解压快，利于快速启动）
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
# BR2_TARGET_ROOTFS_EXT2 is not set

# 应用
BR2_PACKAGE_DVR_APP=y

# 存储与网络
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_CHRONY=y

# 媒体：摄像头 3A、MPP 硬件编码、精简 GStreamer
# [待核对] Rockchip 包名
BR2_PACKAGE_CAMERA_ENGINE_RKAIQ=y
BR2_PACKAGE_MPP=y
BR2_PACKAGE_LIBRGA=y
BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MULTIFILE=y
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_MPEGTSMUX=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
# [待核对] Rockchip 的 GStreamer MPP 插件包名
BR2_PACKAGE_GSTREAMER1_ROCKCHIP=y

# 去掉出厂系统里与 DVR 无关的组件
# BR2_PACKAGE_WESTON is not set
# BR2_PACKAGE_QT5 is not set
# BR2_PACKAGE_PULSEAUDIO is not set
# BR2_PACKAGE_NGINX is not set
# BR2_PACKAGE_CONNMAN is not set
# BR2_PACKAGE_DBUS is not set
# BR2_PACKAGE_PYTHON3 is not set
# BR2_PACKAGE_BLUEZ5_UTILS is not set
# BR2_PACKAGE_ANDROID_TOOLS is not set
# BR2_PACKAGE_GST1_PLUGINS_UGLY is not set
